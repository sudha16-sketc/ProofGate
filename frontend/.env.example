# ProofGate frontend environment configuration.
# Copy to `.env.local` and edit. All variables are optional; the preview
# network defaults are used when unset.

# Network the dApp connects to. Must match the network your Midnight wallet
# (Lace) is switched to. Supported: preview | preprod
VITE_NETWORK=preview

# Address of a previously deployed ProofGate contract on that network.
# Deploy with `npm run deploy -- --network preview` in the repo root and copy
# the address here.
VITE_CONTRACT_ADDRESS=5a9da9e2b18eb74f06d604dd60595956a7d9d186b6e82fffc989d3adf93d73d8

# Public indexer used to read the contract's public ledger.
# The wallet supplies its own indexer via getConfiguration() for the PermitGate
# actions; this is only the fallback used by the read-only ledger view.
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
