# ProofGate frontend environment configuration.
# Copy to `.env.local` and edit. All variables are optional; the PREVIEW
# network defaults are used when unset — the app is Preview-first and never
# silently falls back to a local devnet.

# Network the dApp connects to. Must match the network your Midnight wallet
# (Lace) is switched to. Supported: preview | preprod | undeployed.
# `undeployed` is the local Docker devnet and requires the compose stack;
# it is only used when explicitly set. Default: preview
VITE_NETWORK_ID=preview
# Legacy alias for VITE_NETWORK_ID (kept for compatibility).
# VITE_NETWORK=preview

# Address of a previously deployed ProofGate contract on that network.
# Deploy with `npm run deploy -- --network preview` in the repo root and copy
# the address here.
VITE_CONTRACT_ADDRESS=0f7b8eb912f4acc9e6c24d6463512534c4e03d0f04cb7b3aae0810f9d830a540

# Public indexer used to read the contract's public ledger.
# The wallet supplies its own indexer via getConfiguration() for transaction
# actions; this is the fallback used by the read-only ledger view.
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql

# Proof-server endpoint. ProofGate uses custom circuits, so the Lace wallet's
# own (remote) proving backend cannot prove them ("key not found: <circuit>").
# The dApp therefore proves via a locally-run official midnightntwrk/proof-server
# instance using httpClientProofProvider — same path as the CLI — which sends
# the circuit key material with every request. Requires
# `docker compose up -d --wait proof-server`.
VITE_PROOF_SERVER_URL=http://127.0.0.1:6300

# Analytics API base URL. Empty (default) means same-origin: the Vite dev
# server proxies /api to the local analytics server, and production Express
# serves both. Set only when the API lives on a different origin.
# VITE_API_URL=https://proofgate.example.com
