# ProofGate analytics server — environment configuration.
# Copy to `.env` (repo root) and edit. The `.env` file is git-ignored; never
# commit MONGODB_URI or ADMIN_API_TOKEN.

# MongoDB connection string for the analytics store. Use MongoDB Atlas for the
# Level 5 deployment. The URI is read ONLY by the server process — it must
# never be exposed to the browser.
#
# Leave UNSET for a zero-setup local dev fallback: the server runs against an
# in-memory MongoDB (mongodb-memory-server) whose data resets on restart.
MONGODB_URI=
MONGODB_DATABASE=proofgate

# HTTP port for the analytics API (default 8787). The frontend's Vite dev
# server proxies /api here; production Express serves the built frontend too.
PORT=8787

# Bearer token guarding GET /api/admin/users (the wallet-level export).
# Generate one, e.g.:  openssl rand -hex 24
ADMIN_API_TOKEN=

# The Preprod onboarding target tracked on the landing page ("37 / 50").
PREPROD_TARGET_NETWORK=preprod
PREPROD_TARGET_COUNT=50

# Users are "active" if they performed any operation within this many days.
ANALYTICS_ACTIVE_DAYS=30

# Event ingestion rate limit (per IP).
ANALYTICS_RATE_LIMIT_MS=60000
ANALYTICS_RATE_LIMIT_MAX=120

# CORS origin allowed to call the API from the browser. Use the Vite dev origin
# in development (e.g. http://localhost:5173) or your deployed frontend.
CORS_ORIGIN=https://proof-gate-one.vercel.app
