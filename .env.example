# ProofGate analytics server — environment configuration.
# Copy to `.env` (repo root) and edit. The `.env` file is git-ignored; never
# commit MONGODB_URI or ADMIN_API_TOKEN.

# MongoDB connection string for the analytics store. Use MongoDB Atlas for the
# Level 5 deployment. The URI is read ONLY by the server process — it must
# never be exposed to the browser.
#
# Leave UNSET for a zero-setup local dev fallback: the server runs against an
# in-memory MongoDB (mongodb-memory-server) whose data resets on restart.
MONGODB_URI=
MONGODB_DATABASE=proofgate

# HTTP port for the analytics API (default 8787). The frontend's Vite dev
# server proxies /api here; production Express serves the built frontend too.
PORT=8787

# Bearer token guarding GET /api/admin/users (the wallet-level export).
# Generate one, e.g.:  openssl rand -hex 24
ADMIN_API_TOKEN=

# The Preprod onboarding target tracked on the landing page ("37 / 50").
PREPROD_TARGET_NETWORK=preprod
PREPROD_TARGET_COUNT=50

# Users are "active" if they performed any operation within this many days.
ANALYTICS_ACTIVE_DAYS=30

# Event ingestion rate limit (per IP).
ANALYTICS_RATE_LIMIT_MS=60000
ANALYTICS_RATE_LIMIT_MAX=120
CORS_ORIGIN=https://proof-gate-tau.vercel.app/

# Base URL of the Midnight proof server that the /check and /prove relay streams
# to. ZK proving NEVER runs on Render — it happens on a developer machine.
#   - local dev:  the docker-compose proof server (default http://127.0.0.1:6300)
#   - production: the HTTPS URL of the secure tunnel to the LOCAL proof server
#     (e.g. https://<your-tunnel>.trycloudflare.com). Render cannot reach your
#     laptop's 127.0.0.1 directly, so the tunnel is the only path. See
#     docs/PROVING_ARCHITECTURE.md.
PROOF_SERVER_URL=https://mistakes-expects-senate-pens.trycloudflare.com

# Shared secret used to authenticate the relay -> local proof-server connection.
# The relay sends it as `Authorization: Bearer <token>` and the local tunnel
# proxy (proof-server/tunnel-proxy.mjs) rejects any request without it. Generate
# one, e.g.:  openssl rand -hex 24
# Leave empty only when the proof server is NOT publicly reachable (local dev).
PROOF_SERVER_AUTH_TOKEN=19bef0fff4b26b70b87ee96c6b715e719082eb907935ca08

# Hard cap (ms) for a relayed /prove round trip to the proof server. Default
# 1200000 (20 min). A cold-started proof server downloads SRS params first and
# CPU-heavy circuits take minutes, so this must stay far above the old 5-minute
# cap or slow-but-live proofs are aborted as "Failed to fetch".
PROOF_SERVER_TIMEOUT_MS=1200000
